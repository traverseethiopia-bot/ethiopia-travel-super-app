# Environment example for Ethiopia Travel Super App

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_strong_random_string
JWT_REFRESH_SECRET=replace_with_a_strong_random_string

# Cloudinary (for image uploads). Create an account at https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP) - Gmail example: use an app password if 2FA is enabled
EMAIL_USER=youremail@example.com
EMAIL_PASSWORD=your_smtp_password_or_app_password

# Optional: other service keys
# SENTRY_DSN=
